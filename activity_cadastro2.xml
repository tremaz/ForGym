<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".Cadastro2">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Imagem -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- CEP -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/CepField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CEP"
            app:boxStrokeColor="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/CepEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColorHint="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Rua -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/RuaField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rua"
            app:boxStrokeColor="@color/black"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/RuaEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColorHint="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Número -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/NumeroField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número"
            app:boxStrokeColor="@color/black"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/NumeroEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColorHint="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Complemento -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ComplementoField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Complemento"
            app:boxStrokeColor="@color/black"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ComplementoEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColorHint="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Cidade -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/CidadeField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cidade"
            app:boxStrokeColor="@color/black"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/CidadeEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColorHint="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bairro -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/BairroField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bairro"
            app:boxStrokeColor="@color/black"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/BairroEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColorHint="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>


        <!-- Botão -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_proximo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próximo"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/blue"
            android:textColor="@color/white"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
